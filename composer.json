{
  "name": "lucida/lucida-laravel",
  "description": "Laravel integration for Lucida: client singleton, facade, visitor middleware, flags bootstrap directive",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/lucidaanalytics/lucida-laravel",
  "support": { "issues": "https://github.com/lucidaanalytics/lucida-laravel/issues", "source": "https://github.com/lucidaanalytics/lucida-laravel" },
  "require": {
    "php": ">=8.1",
    "lucida/lucida": "^0.1",
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Lucida\\Laravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Lucida\\Laravel\\LucidaServiceProvider"
      ],
      "aliases": {
        "Lucida": "Lucida\\Laravel\\Facades\\Lucida"
      }
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "test:boot": "php tests/boot.php"
  },
  "require-dev": {
    "orchestra/testbench": "^10"
  }
}
